  <script>
    let paycheckChartInstance = null;
    let breakevenChartInstance = null;

    function formatUSD(num) { return '$' + Math.round(num).toLocaleString('en-US'); }

    function showToast(msg) {
      const toast = document.getElementById('appToast');
      toast.textContent = msg;
      toast.classList.remove('hidden');
      clearTimeout(window._toastTimer);
      window._toastTimer = setTimeout(() => toast.classList.add('hidden'), 3500);
    }

    function applyPreset(preset) {
      document.querySelectorAll('.preset-btn').forEach(b => {
        const isActive = b.getAttribute('data-preset') === preset;
        b.className = isActive
          ? 'preset-btn px-3 py-1.5 rounded-lg bg-amber-400 text-slate-950 font-bold text-xs hover:bg-amber-300 shadow-sm'
          : 'preset-btn px-3 py-1.5 rounded-lg bg-emerald-800 text-amber-100 font-semibold text-xs hover:bg-emerald-700 border border-amber-400/30';
      });

      if (preset === 'single') {
        document.getElementById('ssYourCheck').value = 2050;
        document.getElementById('ssSpouseCheck').value = 0;
        document.getElementById('nestEggInput').value = 380000;
        document.getElementById('withdrawalRateInput').value = 4.4;
        document.getElementById('expHousing').value = 1150;
        document.getElementById('expGroceries').value = 520;
        document.getElementById('expHealthcare').value = 420;
        document.getElementById('expCarFun').value = 450;
        document.getElementById('taxFilingStatus').value = 'single';
        document.getElementById('taxPreTaxDraw').value = 16000;
        document.getElementById('irmaa2025Income').value = 118000;
        showToast('Loaded Single Retiree Profile (Age 66, $380K Nest Egg)');
      } else if (preset === 'couple400k') {
        document.getElementById('ssYourCheck').value = 1940;
        document.getElementById('ssSpouseCheck').value = 1160;
        document.getElementById('nestEggInput').value = 400000;
        document.getElementById('withdrawalRateInput').value = 4.5;
        document.getElementById('expHousing').value = 1350;
        document.getElementById('expGroceries').value = 750;
        document.getElementById('expHealthcare').value = 650;
        document.getElementById('expCarFun').value = 550;
        document.getElementById('taxFilingStatus').value = 'married';
        document.getElementById('taxPreTaxDraw').value = 24000;
        document.getElementById('irmaa2025Income').value = 230000;
        showToast('Loaded Married Couple Profile (Age 62, $400K Nest Egg)');
      } else if (preset === 'latesaver') {
        document.getElementById('ssYourCheck').value = 1780;
        document.getElementById('ssSpouseCheck').value = 950;
        document.getElementById('nestEggInput').value = 120000;
        document.getElementById('withdrawalRateInput').value = 4.0;
        document.getElementById('expHousing').value = 980;
        document.getElementById('expGroceries').value = 600;
        document.getElementById('expHealthcare').value = 480;
        document.getElementById('expCarFun').value = 350;
        document.getElementById('taxFilingStatus').value = 'married';
        document.getElementById('taxPreTaxDraw').value = 6000;
        document.getElementById('irmaa2025Income').value = 88000;
        showToast('Loaded Late Saver Recovery Plan ($120K Nest Egg)');
      }
      updateAllCalculations();
    }

    function updateAllCalculations() {
      const ssYou = parseFloat(document.getElementById('ssYourCheck').value) || 0;
      const ssSpouse = parseFloat(document.getElementById('ssSpouseCheck').value) || 0;
      const colaPct = parseFloat(document.getElementById('colaPctInput').value) || 3.6;
      const partBHike = parseFloat(document.getElementById('partBIncreaseInput').value) || 0;
      document.getElementById('colaPctVal').textContent = colaPct.toFixed(1);

      const householdPeople = ssSpouse > 0 ? 2 : 1;
      const currentGrossSS = ssYou + ssSpouse;
      const grossColaRaise = currentGrossSS * (colaPct / 100);
      const totalMedicareHike = partBHike * householdPeople;
      const netRaise = grossColaRaise - totalMedicareHike;
      const standardPartBTotal = 202.90 * householdPeople;
      const newNetSS = (currentGrossSS + grossColaRaise) - (standardPartBTotal + totalMedicareHike);
      const bitePct = grossColaRaise > 0 ? Math.min(100, Math.round((totalMedicareHike / grossColaRaise) * 100)) : 0;

      document.getElementById('kpiGrossCola').textContent = '+' + formatUSD(grossColaRaise) + '/mo';
      document.getElementById('kpiGrossCheckSub').textContent = 'Gross SS climbs to ' + formatUSD(currentGrossSS + grossColaRaise) + '/mo';
      document.getElementById('kpiMedicareBite').textContent = '-' + formatUSD(totalMedicareHike) + '/mo';
      document.getElementById('kpiMedicareSub').textContent = 'Takes ' + bitePct + '% of your new COLA raise';
      document.getElementById('kpiNetSS').textContent = formatUSD(Math.max(0, newNetSS)) + '/mo';
      document.getElementById('kpiNetRaiseSub').textContent = 'Real net raise after Medicare: ' + (netRaise >= 0 ? '+' : '') + formatUSD(netRaise) + '/mo';
      document.getElementById('buyingPowerLossBadge').textContent = '-' + formatUSD(currentGrossSS * 0.14) + '/mo vs 10 yrs ago (86¢/$1)';

      const nestEgg = parseFloat(document.getElementById('nestEggInput').value) || 0;
      const drawRate = parseFloat(document.getElementById('withdrawalRateInput').value) || 4.5;
      document.getElementById('withdrawalRateVal').textContent = drawRate.toFixed(1);

      const annualPortDraw = nestEgg * (drawRate / 100);
      const monthlyPortDraw = annualPortDraw / 12;
      const totalCoreExp = (parseFloat(document.getElementById('expHousing').value) || 0) +
                           (parseFloat(document.getElementById('expGroceries').value) || 0) +
                           (parseFloat(document.getElementById('expHealthcare').value) || 0) +
                           (parseFloat(document.getElementById('expCarFun').value) || 0);

      const totalMonthlyPaycheck = Math.max(0, newNetSS) + monthlyPortDraw;
      const monthlySurplus = totalMonthlyPaycheck - totalCoreExp;

      document.getElementById('kpiTotalPaycheck').textContent = formatUSD(totalMonthlyPaycheck) + '/mo';
      const surplusEl = document.getElementById('kpiBudgetSurplus');
      surplusEl.textContent = (monthlySurplus >= 0 ? '+' : '') + formatUSD(monthlySurplus) + '/mo ' + (monthlySurplus >= 0 ? 'breathing room' : 'shortfall');

      const annualTotalRetire = totalMonthlyPaycheck * 12;
      document.getElementById('equivRetireAnnual').textContent = formatUSD(annualTotalRetire) + '/yr';
      document.getElementById('equivWorkingSalary').textContent = formatUSD(annualTotalRetire / 0.72) + '/yr';

      const b1 = Math.min(nestEgg, annualPortDraw * 2);
      const b2 = Math.min(Math.max(0, nestEgg - b1), annualPortDraw * 6);
      const b3 = Math.max(0, nestEgg - b1 - b2);
      const yearsProtected = annualPortDraw > 0 ? Math.round((b1 + b2) / annualPortDraw) : 8;
      document.getElementById('monthlyPortfolioDrawBadge').textContent = formatUSD(monthlyPortDraw) + '/mo Draw';
      document.getElementById('bucket1Amt').textContent = formatUSD(b1);
      document.getElementById('bucket2Amt').textContent = formatUSD(b2);
      document.getElementById('bucket3Amt').textContent = formatUSD(b3);
      document.getElementById('yearsProtectedText').textContent = yearsProtected + ' full years';

      const gogoSpend = totalCoreExp;
      const slowgoSpend = Math.round(totalCoreExp * 0.85);
      const nogoSpend = Math.round(totalCoreExp * 0.95);
      document.getElementById('gogoSpendText').textContent = formatUSD(gogoSpend) + '/mo';
      document.getElementById('slowgoSpendText').textContent = formatUSD(slowgoSpend) + '/mo';
      document.getElementById('nogoSpendText').textContent = formatUSD(nogoSpend) + '/mo';
      updatePaycheckChart(Math.max(0, newNetSS), monthlyPortDraw, gogoSpend, slowgoSpend, nogoSpend);

      const fraBenefit = parseFloat(document.getElementById('fraBenefitInput').value) || 2200;
      const targetAge = parseInt(document.getElementById('lifeExpInput').value, 10) || 82;
      document.getElementById('lifeExpVal').textContent = targetAge;
      const mo62 = fraBenefit * 0.70, mo67 = fraBenefit, mo70 = fraBenefit * 1.24;
      document.getElementById('claim62Mo').textContent = formatUSD(mo62) + '/mo';
      document.getElementById('claim67Mo').textContent = formatUSD(mo67) + '/mo';
      document.getElementById('claim70Mo').textContent = formatUSD(mo70) + '/mo';
      document.getElementById('claim62Total').textContent = 'Total by ' + targetAge + ': ' + formatUSD(Math.max(0, targetAge - 62) * 12 * mo62);
      document.getElementById('claim67Total').textContent = 'Total by ' + targetAge + ': ' + formatUSD(Math.max(0, targetAge - 67) * 12 * mo67);
      document.getElementById('claim70Total').textContent = 'Total by ' + targetAge + ': ' + formatUSD(Math.max(0, targetAge - 70) * 12 * mo70);
      updateBreakevenChart(mo62, mo67, mo70);

      const sideGigEarned = parseFloat(document.getElementById('sideGigIncome').value) || 0;
      const hourlyWage = parseFloat(document.getElementById('sideGigHourly').value) || 25;
      const safeHours = Math.floor((24480 / 12) / hourlyWage);
      const sideGigBox = document.getElementById('sideGigResultBox');
      if (sideGigEarned > 24480) {
        const excess = sideGigEarned - 24480;
        sideGigBox.className = 'p-3.5 rounded-xl bg-red-50 border border-red-300 text-sm space-y-1';
        document.getElementById('sideGigPenaltyTitle').textContent = '⚠️ Penalty Alert: ' + formatUSD(excess / 2) + '/yr Withheld!';
        document.getElementById('sideGigPenaltyDesc').innerHTML = 'You are ' + formatUSD(excess) + ' above $24,480. Cap work at <strong>' + safeHours + ' hrs/mo</strong> ($2,040/mo) to avoid early Social Security clawbacks.';
      } else {
        sideGigBox.className = 'p-3.5 rounded-xl bg-emerald-50 border border-emerald-300 text-sm space-y-1';
        document.getElementById('sideGigPenaltyTitle').textContent = '✅ $0 Penalty (You Keep 100% of Your Check!)';
        document.getElementById('sideGigPenaltyDesc').innerHTML = 'You are ' + formatUSD(24480 - sideGigEarned) + ' below the limit. You can work up to <strong>' + safeHours + ' hrs/mo</strong> penalty-free.';
      }

      const mortBal = parseFloat(document.getElementById('mortBalance').value) || 0;
      const mortR = parseFloat(document.getElementById('mortRate').value) || 3.5;
      const hysaR = parseFloat(document.getElementById('hysaRate').value) || 4.6;
      document.getElementById('mortVerdictBox').innerHTML = hysaR >= mortR
        ? '<strong>Keep Cash in Bucket 1–2:</strong> Safe CDs/T-Bills earn <strong>' + hysaR + '%</strong> vs your <strong>' + mortR + '%</strong> mortgage (+' + formatUSD(mortBal * ((hysaR - mortR) / 100)) + '/yr net gain).'
        : '<strong>Pay Off Gradually:</strong> Your mortgage (' + mortR + '%) costs more than safe cash yields (' + hysaR + '%), costing ' + formatUSD(mortBal * ((mortR - hysaR) / 100)) + '/yr.';

      const status = document.getElementById('taxFilingStatus').value;
      const preTaxDraw = parseFloat(document.getElementById('taxPreTaxDraw').value) || 0;
      const rothDraw = parseFloat(document.getElementById('taxRothDraw').value) || 0;
      const interestInc = parseFloat(document.getElementById('taxInterest').value) || 0;
      const annualGrossSS = (currentGrossSS + grossColaRaise) * 12;
      const combinedIncome = preTaxDraw + interestInc + (0.5 * annualGrossSS);
      const line50 = status === 'married' ? 32000 : 25000;
      const line85 = status === 'married' ? 44000 : 34000;

      document.getElementById('combinedIncomeValue').textContent = formatUSD(combinedIncome) + ' / yr';
      document.getElementById('taxLine50Label').textContent = '50% Line (' + formatUSD(line50) + ')';
      document.getElementById('taxLine85Label').textContent = '85% Line (' + formatUSD(line85) + ')';

      const meterPct = Math.min(100, Math.max(8, Math.round((combinedIncome / (line85 * 1.25)) * 100)));
      const meterBar = document.getElementById('taxMeterBar');
      meterBar.style.width = meterPct + '%';

      let taxZoneLabel = '0% Zone';
      if (combinedIncome <= line50) {
        meterBar.className = 'h-full rounded-full transition-all duration-300 bg-emerald-400';
        document.getElementById('ghostTaxStatusText').innerHTML = '✅ <strong>0% Tax-Free Social Security Zone!</strong> Your combined income sits below ' + formatUSD(line50) + ' (plus your ' + formatUSD(rothDraw) + '/yr Roth draw is 100% tax-free).';
      } else if (combinedIncome <= line85) {
        meterBar.className = 'h-full rounded-full transition-all duration-300 bg-amber-400';
        document.getElementById('ghostTaxStatusText').innerHTML = '⚡ <strong>50% Tax Zone:</strong> Shift <strong>' + formatUSD(combinedIncome - line50) + '/yr</strong> from Pre-Tax 401(k) to your <strong>Roth bucket</strong> to make Social Security 0% tax-free!';
        taxZoneLabel = '50% Zone';
      } else {
        meterBar.className = 'h-full rounded-full transition-all duration-300 bg-red-500';
        document.getElementById('ghostTaxStatusText').innerHTML = '⚠️ <strong>85% Tax Zone:</strong> Shift <strong>' + formatUSD(combinedIncome - line85) + '/yr (' + formatUSD((combinedIncome - line85) / 12) + '/mo)</strong> from Traditional 401(k) to your <strong>Roth valve</strong> to drop out of the 85% tax zone!';
        taxZoneLabel = '85% Zone';
      }

      const standardDed = status === 'married' ? 33200 : 16600;
      const bracket12Top = status === 'married' ? 96950 : 48475;
      const currentTaxable = Math.max(0, (preTaxDraw + interestInc + (combinedIncome > line50 ? 0.5 * annualGrossSS : 0)) - standardDed);
      const rothSweetSpotRoom = Math.max(0, bracket12Top - currentTaxable);
      document.getElementById('rothSweetSpotBox').innerHTML =
        '<div class="font-extrabold text-emerald-950">🎯 Your Annual Roth Conversion "Sweet Spot" (Before Age 73 RMDs): ' + formatUSD(rothSweetSpotRoom) + '/yr</div>' +
        '<p class="text-xs text-slate-700">You can convert up to <strong>' + formatUSD(rothSweetSpotRoom) + '</strong> this year from your Traditional 401(k)/IRA into a tax-free Roth IRA while staying inside the low 12% federal bracket!</p>';

      document.getElementById('superCatchupOutput').innerHTML = document.getElementById('workerAgeSelect').value === '61'
        ? '🎉 <strong>Age 60–63 Super Catch-Up:</strong> Up to <strong>$35,750</strong> total 401(k) limit ($11,250 catch-up)!'
        : '📌 <strong>Age 50+ Standard Catch-Up:</strong> Up to <strong>$32,500</strong> total 401(k) limit.';

      const irmaaIncome = parseFloat(document.getElementById('irmaa2025Income').value) || 0;
      const irmaaLimit = status === 'married' ? 212000 : 106000;
      document.getElementById('irmaaVerdictBox').innerHTML = (irmaaIncome > irmaaLimit && document.getElementById('irmaaRetiredEvent').value === 'yes')
        ? '<div class="font-extrabold text-emerald-950">✅ File Form SSA-44 Immediately (Save ~$1,800+/yr)!</div><p class="text-xs text-slate-800">Your 2025 working income (' + formatUSD(irmaaIncome) + ') exceeds ' + formatUSD(irmaaLimit) + '. File <strong>Form SSA-44 (Work Stoppage)</strong> so Medicare drops your 2027 IRMAA surcharge!</p>'
        : irmaaIncome > irmaaLimit
          ? '<div class="font-extrabold text-amber-950">⚠️ 2027 IRMAA Surcharge Applies</div><p class="text-xs text-slate-800">Your 2025 MAGI (' + formatUSD(irmaaIncome) + ') exceeds ' + formatUSD(irmaaLimit) + '.</p>'
          : '<div class="font-extrabold text-emerald-950">🎉 $0 IRMAA Surcharge (' + formatUSD(irmaaLimit - irmaaIncome) + ' safety buffer)!</div>';

      const acaAge = parseInt(document.getElementById('acaCurrentAge').value, 10) || 62;
      const acaMagi = parseFloat(document.getElementById('acaMagiInput').value) || 52000;
      document.getElementById('acaBridgeResult').innerHTML = '<strong>🏥 ' + Math.max(0, 65 - acaAge) + '-Year Bridge to Medicare:</strong> Estimated ACA benchmark Silver plan near <strong>~' + formatUSD((acaMagi * 0.068) / 12) + '/mo</strong>. Use Roth/Cash for extra expenses to protect your subsidy!';

      document.getElementById('printNetSS').textContent = formatUSD(Math.max(0, newNetSS)) + '/mo';
      document.getElementById('printPortDraw').textContent = formatUSD(monthlyPortDraw) + '/mo (' + drawRate.toFixed(1) + '%)';
      document.getElementById('printBuckets').textContent = 'Cash: ' + formatUSD(b1) + ' • Bonds: ' + formatUSD(b2) + ' • Growth: ' + formatUSD(b3);
      document.getElementById('printTaxStatus').textContent = 'Combined: ' + formatUSD(combinedIncome) + ' (' + taxZoneLabel + ')';
    }

    function updatePaycheckChart(netSS, portDraw, gogo, slowgo, nogo) {
      const ctx = document.getElementById('paycheckChart');
      if (!ctx || typeof Chart === 'undefined') return;
      const vals = [Math.round(netSS + portDraw), gogo, slowgo, nogo];
      if (paycheckChartInstance) { paycheckChartInstance.data.datasets[0].data = vals; paycheckChartInstance.update(); return; }
      paycheckChartInstance = new Chart(ctx, {
        type: 'bar',
        data: { labels: ['Monthly Paycheck', 'Go-Go (60s)', 'Slow-Go (70s)', 'No-Go (80s)'], datasets: [{ data: vals, backgroundColor: ['#1b4332', '#059669', '#d97706', '#0284c7'], borderRadius: 8 }] },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
      });
    }

    function updateBreakevenChart(mo62, mo67, mo70) {
      const ctx = document.getElementById('breakevenChart');
      if (!ctx || typeof Chart === 'undefined') return;
      const ages = [62, 65, 67, 70, 75, 79, 83, 87, 90];
      const s62 = ages.map(a => Math.max(0, a - 62) * 12 * mo62);
      const s67 = ages.map(a => Math.max(0, a - 67) * 12 * mo67);
      const s70 = ages.map(a => Math.max(0, a - 70) * 12 * mo70);
      if (breakevenChartInstance) {
        breakevenChartInstance.data.datasets[0].data = s62;
        breakevenChartInstance.data.datasets[1].data = s67;
        breakevenChartInstance.data.datasets[2].data = s70;
        breakevenChartInstance.update();
        return;
      }
      breakevenChartInstance = new Chart(ctx, {
        type: 'line',
        data: {
          labels: ages.map(a => 'Age ' + a),
          datasets: [
            { label: 'Claim 62', data: s62, borderColor: '#d97706', borderWidth: 3 },
            { label: 'Claim 67', data: s67, borderColor: '#1b4332', borderWidth: 3 },
            { label: 'Claim 70', data: s70, borderColor: '#0284c7', borderWidth: 3 }
          ]
        },
        options: { responsive: true, maintainAspectRatio: false }
      });
    }

    window.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('input, select').forEach(el => {
        el.addEventListener('input', updateAllCalculations);
        el.addEventListener('change', updateAllCalculations);
      });

      document.querySelectorAll('.nav-tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const tabId = btn.getAttribute('data-tab');
          document.querySelectorAll('.tab-panel').forEach(p => p.classList.toggle('hidden', p.id !== tabId));
          document.querySelectorAll('.nav-tab-btn').forEach(b => {
            b.className = b === btn
              ? 'nav-tab-btn py-3 px-3 rounded-lg font-bold text-sm bg-[#1b4332] text-amber-300 shadow'
              : 'nav-tab-btn py-3 px-3 rounded-lg font-bold text-sm bg-white text-slate-800 hover:bg-amber-50';
          });
          if (paycheckChartInstance) paycheckChartInstance.resize();
          if (breakevenChartInstance) breakevenChartInstance.resize();
        });
      });

      document.querySelectorAll('.preset-btn').forEach(btn => {
        btn.addEventListener('click', () => applyPreset(btn.getAttribute('data-preset')));
      });

      document.querySelectorAll('.scam-check').forEach(chk => {
        chk.addEventListener('change', () => {
          const count = document.querySelectorAll('.scam-check:checked').length;
          const banner = document.getElementById('scamAlertBanner');
          if (count === 0) {
            banner.className = 'p-4 rounded-xl bg-emerald-50 border-2 border-emerald-400 text-sm';
            banner.innerHTML = '<div class="font-extrabold text-emerald-950">🛡️ No Red Flags Checked Yet</div><p class="text-xs text-slate-700 mt-1">Social Security, the IRS, and Medicare will NEVER call, text, or email you to demand fees or bank passwords.</p>';
          } else {
            banner.className = 'p-4 rounded-xl bg-red-100 border-2 border-red-600 text-sm';
            banner.innerHTML = '<div class="font-extrabold text-red-950">🚨 100% SCAM DETECTED (' + count + ' Red Flag' + (count > 1 ? 's' : '') + ') — HANG UP OR DELETE IMMEDIATELY!</div><p class="text-xs text-red-900 mt-1">Do NOT click any links or share your Medicare/SSN. Call Social Security directly at <strong>1-800-772-1213</strong> or report at <strong>OIG.SSA.GOV</strong>.</p>';
          }
        });
      });

      document.querySelectorAll('.audit-check').forEach(chk => {
        chk.addEventListener('change', () => {
          const done = document.querySelectorAll('.audit-check:checked').length;
          document.getElementById('checklistProgressBadge').textContent = done + ' / 5 Done';
          if (done === 5) showToast('🎉 All 5 November Protection Steps Completed!');
        });
      });

      document.getElementById('fontNormalBtn').onclick = () => { document.documentElement.style.setProperty('--base-font', '16px'); showToast('Text size: Normal'); };
      document.getElementById('fontLargeBtn').onclick = () => { document.documentElement.style.setProperty('--base-font', '18.5px'); showToast('Text size: Large'); };
      document.getElementById('fontXLargeBtn').onclick = () => { document.documentElement.style.setProperty('--base-font', '21px'); showToast('Text size: Senior XL'); };
      function toggleUserGuide(forceOpen) {
        const body = document.getElementById('userGuideBody');
        const label = document.getElementById('collapseGuideLabel');
        const isHidden = body.classList.contains('hidden');
        const shouldOpen = typeof forceOpen === 'boolean' ? forceOpen : isHidden;
        body.classList.toggle('hidden', !shouldOpen);
        label.textContent = shouldOpen ? '▲ Hide Guide' : '▼ Show 3-Min Guide';
        if (shouldOpen) {
          document.getElementById('userGuideSection').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      }

      document.getElementById('collapseGuideBtn').onclick = () => toggleUserGuide();
      document.getElementById('toggleGuideTopBtn').onclick = () => toggleUserGuide(true);

      document.querySelectorAll('.guide-tab-link').forEach(btn => {
        btn.addEventListener('click', () => {
          const targetTab = btn.getAttribute('data-goto-tab');
          const navBtn = document.querySelector('.nav-tab-btn[data-tab="' + targetTab + '"]');
          if (navBtn) {
            navBtn.click();
            navBtn.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        });
      });

      document.getElementById('openGlossaryBtn').onclick = () => document.getElementById('glossaryModal').classList.remove('hidden');
      document.getElementById('closeGlossaryBtn').onclick = () => document.getElementById('glossaryModal').classList.add('hidden');
      document.getElementById('openPrivacyBtn').onclick = () => document.getElementById('privacyModal').classList.remove('hidden');
      document.getElementById('openPrivacyFooterBtn').onclick = () => document.getElementById('privacyModal').classList.remove('hidden');
      document.getElementById('closePrivacyBtn').onclick = () => document.getElementById('privacyModal').classList.add('hidden');
      document.getElementById('printPlanBtn').onclick = () => window.print();

      document.getElementById('copySummaryBtn').onclick = () => {
        const text = [
          'NO-SUIT RETIREMENT — MY PERSONALIZED PLAN',
          '• 2027 Net Social Security: ' + document.getElementById('printNetSS').textContent,
          '• Safe Portfolio Draw: ' + document.getElementById('printPortDraw').textContent,
          '• Total Monthly Paycheck: ' + document.getElementById('kpiTotalPaycheck').textContent,
          '• 3-Bucket Allocation: ' + document.getElementById('printBuckets').textContent,
          '• 1984 IRS Tax Status: ' + document.getElementById('printTaxStatus').textContent,
          '• Will & POA Location: ' + document.getElementById('locWill').value,
          '• 401(k)/IRA Institutions: ' + document.getElementById('loc401k').value
        ].join('\n');
        const ta = document.createElement('textarea');
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        showToast('📋 Plan summary copied to clipboard!');
      };

      document.getElementById('readAloudBtn').onclick = () => {
        if (!('speechSynthesis' in window)) return showToast('Speech not supported in this browser.');
        if (window.speechSynthesis.speaking) {
          window.speechSynthesis.cancel();
          document.getElementById('readAloudLabel').textContent = '🔊 Listen to My Summary';
          return;
        }
        const u = new SpeechSynthesisUtterance(
          'Welcome to No-Suit Retirement. Based on your numbers, your true net Social Security check after Medicare Part B is ' +
          document.getElementById('kpiNetSS').textContent +
          '. Combined with your safe portfolio draw, your total monthly retirement paycheck is ' +
          document.getElementById('kpiTotalPaycheck').textContent +
          '. Your 3-Bucket shield holds ' + document.getElementById('bucket1Amt').textContent + ' in safe cash.'
        );
        u.lang = 'en-US';
        u.rate = 0.95;
        u.onend = () => { document.getElementById('readAloudLabel').textContent = '🔊 Listen to My Summary'; };
        document.getElementById('readAloudLabel').textContent = '⏹ Stop Reading';
        window.speechSynthesis.speak(u);
      };

      updateAllCalculations();
    });
  </script>
</body>
</html>